@page
@model SistemaContable.Pages.Asientos.CreateModel

<h2>Nuevo Asiento Contable</h2>

<form method="post">

    <!-- ================= ENCABEZADO ================= -->

    <h4>Encabezado</h4>

    <div class="mb-2">
        <input asp-for="Asiento.Consecutivo"
               class="form-control"
               placeholder="Consecutivo" />
    </div>

    <div class="mb-2">
        <input asp-for="Asiento.Fecha"
               type="date"
               class="form-control" />
    </div>

    <div class="mb-2">
        <input asp-for="Asiento.Codigo"
               class="form-control"
               placeholder="Código" />
    </div>

    <div class="mb-2">
        <input asp-for="Asiento.Referencia"
               class="form-control"
               placeholder="Referencia" />
    </div>

    <hr />

    <!-- ================= DETALLE ================= -->

    <h4>Detalle del Asiento</h4>

    <table class="table table-bordered" id="detalles">
        <thead class="table-light">
            <tr>
                <th>Cuenta</th>
                <th>Tipo</th>
                <th>Monto</th>
                <th>Descripción</th>
                <th></th>
            </tr>
        </thead>

        <tbody></tbody>
    </table>

    <button type="button"
            class="btn btn-secondary mb-3"
            onclick="agregar()">
        + Agregar Línea
    </button>

    <!-- ================= TOTALES ================= -->

    <hr />

    <div class="mt-3">
        <p><b>Total Debe:</b> ₡<span id="tdebe">@Model.TotalDebe</span></p>
        <p><b>Total Haber:</b> ₡<span id="thaber">@Model.TotalHaber</span></p>

        <div id="balance-msg">
            @if (Model.Balanceado && Model.TotalDebe > 0)
            {
                <div class="alert alert-success">
                    ✔ Asiento Balanceado
                </div>
            }
            else if (Model.TotalDebe > 0)
            {
                <div class="alert alert-danger">
                    ❌ Asiento No Balanceado
                </div>
            }
        </div>
    </div>

    <!-- ================= BOTÓN ================= -->

    <div class="mt-3">
        <button type="submit"
                class="btn btn-primary">
            Guardar Asiento
        </button>

        <a asp-page="Index"
           class="btn btn-secondary">
            Cancelar
        </a>
    </div>

</form>

@section Scripts {

    <script>

        let i = 0;

        function agregar() {
            let fila = `
            <tr>
                <td>
                    <input name="Asiento.Detalles[${i}].Cuenta"
                           class="form-control"
                           required />
                </td>
                <td>
                    <select name="Asiento.Detalles[${i}].TipoMovimiento"
                            class="form-control" onchange="calcular()">
                        <option value="Debe">Debe</option>
                        <option value="Haber">Haber</option>
                    </select>
                </td>
                <td>
                    <input name="Asiento.Detalles[${i}].Monto"
                           type="number"
                           step="0.01"
                           min="0"
                           class="form-control"
                           oninput="calcular()"
                           required />
                </td>
                <td>
                    <input name="Asiento.Detalles[${i}].Descripcion"
                           class="form-control" />
                </td>
                <td>
                    <button type="button"
                            class="btn btn-danger"
                            onclick="this.closest('tr').remove(); calcular();">
                        X
                    </button>
                </td>
            </tr>`;

            document.querySelector("#detalles tbody").insertAdjacentHTML("beforeend", fila);
            i++;
            calcular();
        }

        function calcular() {
            let debe = 0;
            let haber = 0;
            
            const filas = document.querySelectorAll("#detalles tbody tr");
            filas.forEach(f => {
                const tipo = f.querySelector("select").value;
                const monto = parseFloat(f.querySelector("input[type='number']").value) || 0;
                
                if (tipo === "Debe") debe += monto;
                else haber += monto;
            });

            document.getElementById("tdebe").innerText = debe.toLocaleString();
            document.getElementById("thaber").innerText = haber.toLocaleString();

            const msg = document.getElementById("balance-msg");
            if (debe === haber && debe > 0) {
                msg.innerHTML = '<div class="alert alert-success">✔ Asiento Balanceado</div>';
            } else if (debe > 0 || haber > 0) {
                msg.innerHTML = '<div class="alert alert-danger">❌ Asiento No Balanceado</div>';
            } else {
                msg.innerHTML = '';
            }
        }

    </script>

}
