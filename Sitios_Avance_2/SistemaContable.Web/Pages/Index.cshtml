@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}

<div style="text-align: center; margin-top: 60px;">

    <h1 style="font-size: 36px; font-weight: bold;">
        Bienvenido
    </h1>

    <div style="margin-top: 86;">
        <img src="~/images/logo-contador.png"
             alt="Logo de la empresa"
             style="max-width: 250px;" />
    </div>
    <p>
        Para utilizar los servicios
        <br />
        Continúe para realizar su inicio de sesión.
    </p>

    <form method="get" action="@Url.Content("~/Login/Login")">
        <button type="submit">Continuar</button>
    </form>

</div>