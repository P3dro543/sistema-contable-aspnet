@page
@model SistemaContable.Web.Pages.CuentaContable.IndexModel
@{
    ViewData["Title"] = "Catálogo de Cuentas";
}

<h2>Catálogo de Cuentas</h2>

<div class="d-flex justify-content-between mb-3 align-items-center">
    <a asp-page="Create" class="btn btn-primary">Nueva Cuenta</a>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Tipo</th>
            <th>Saldo</th>
            <th>Acepta Mov.</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model.Cuentas)
        {
            <tr>
                <td>@c.Codigo</td>
                <td>@c.Nombre</td>
                <td>@c.Tipo</td>
                <td>@c.TipoSaldo</td>
                <td>
                    @if (c.AceptaMovimiento)
                    {
                        <span class="badge bg-success">Sí</span>
                    }
                    else
                    {
                        <span class="badge bg-danger">No</span>
                    }
                </td>
                <td>
                    <a asp-page="./Edit" asp-route-id="@c.IdCuenta" class="btn btn-warning btn-sm">Editar</a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@c.IdCuenta">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar la cuenta seleccionada? 
                <br/><small class="text-muted">Si tiene historial contable o sub-cuentas, el sistema bloqueará la acción automáticamente.</small>
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="deleteId" value="" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var modalInput = deleteModal.querySelector('#deleteId');
                modalInput.value = id;
            });
        });
    </script>
}

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-p="@(Model.PaginaActual - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                    <a class="page-link" asp-route-p="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-p="@(Model.PaginaActual + 1)">Siguiente</a>
            </li>

        </ul>
    </nav>
}

@if (!string.IsNullOrEmpty(Model.MensajeError))
{
    <div class="alert alert-danger mt-3 fade show">@Model.MensajeError</div>
}
