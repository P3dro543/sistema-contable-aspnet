@model SistemaContable.ViewModels.IndexCuentasViewModel

@{
    ViewData["Title"] = "Administración de Cuentas Contables";
}

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h2>@ViewData["Title"]</h2>
        </div>
        <div class="col text-end">
            <a asp-action="Crear" class="btn btn-primary">
                <i class="bi bi-plus-circle"></i> Nueva Cuenta
            </a>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filtros -->
    <div class="card mb-3">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-4">
                    <label for="filtroEstado" class="form-label">Filtrar por Estado:</label>
                    <select id="filtroEstado" name="estado" class="form-select" onchange="this.form.submit()">
                        <option value="">Todos los estados</option>
                        <option value="activa" selected="@(Context.Request.Query["estado"] == "activa")">Activas</option>
                        <option value="inactiva" selected="@(Context.Request.Query["estado"] == "inactiva")">Inactivas</option>
                    </select>
                </div>
                <div class="col-md-4">
                    <label for="filtroTipo" class="form-label">Filtrar por Tipo:</label>
                    <select id="filtroTipo" name="tipo" class="form-select" onchange="this.form.submit()">
                        <option value="">Todos los tipos</option>
                        <option value="Activo" selected="@(Context.Request.Query["tipo"] == "Activo")">Activo</option>
                        <option value="Pasivo" selected="@(Context.Request.Query["tipo"] == "Pasivo")">Pasivo</option>
                        <option value="Capital" selected="@(Context.Request.Query["tipo"] == "Capital")">Capital</option>
                        <option value="Gasto" selected="@(Context.Request.Query["tipo"] == "Gasto")">Gasto</option>
                        <option value="Ingreso" selected="@(Context.Request.Query["tipo"] == "Ingreso")">Ingreso</option>
                    </select>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <a asp-action="Index" class="btn btn-secondary">Limpiar Filtros</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Tabla de cuentas -->
    <div class="card">
        <div class="card-body">
            @if (Model?.Cuentas?.Any() == true)
            {
                <div class="table-responsive">
                    <table class="table table-striped table-hover">
                        <thead>
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>Tipo</th>
                                <th>Tipo Saldo</th>
                                <th>Cuenta Padre</th>
                                <th>Acepta Movimiento</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var cuenta in Model.Cuentas)
                            {
                                <tr>
                                    <td>@cuenta.Codigo</td>
                                    <td>@cuenta.Nombre</td>
                                    <td>
                                        <span class="badge bg-info">@cuenta.Tipo</span>
                                    </td>
                                    <td>
                                        <span class="badge @cuenta.TipoSaldoClase">
                                            @cuenta.TipoSaldo
                                        </span>
                                    </td>
                                    <td>@(cuenta.NombreCuentaPadre ?? "N/A")</td>
                                    <td>
                                        <span class="badge @cuenta.AceptaMovimientoClase">
                                            @cuenta.AceptaMovimientoTexto
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge @cuenta.EstadoClase">
                                            @cuenta.EstadoTexto
                                        </span>
                                    </td>
                                    <td>
                                        <div class="btn-group" role="group">
                                            <a asp-action="Editar" asp-route-id="@cuenta.IdCuenta"
                                               class="btn btn-sm btn-warning" title="Editar">
                                                <i class="bi bi-pencil"></i>
                                            </a>
                                            <button class="btn btn-sm @(cuenta.Estado ? "btn-secondary" : "btn-success") btn-toggle-estado"
                                                    data-id="@cuenta.IdCuenta"
                                                    data-estado="@cuenta.Estado"
                                                    title="@(cuenta.Estado ? "Desactivar" : "Activar")">
                                                <i class="bi @(cuenta.Estado ? "bi-toggle-off" : "bi-toggle-on")"></i>
                                            </button>
                                            <button class="btn btn-sm btn-danger btn-eliminar"
                                                    data-id="@cuenta.IdCuenta"
                                                    title="Eliminar">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Paginación -->
                @if (Model.TotalPaginas > 1)
                {
                    <nav aria-label="Page navigation">
                        <ul class="pagination justify-content-center">
                            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@(Model.PaginaActual - 1)"
                                   asp-route-estado="@Context.Request.Query["estado"]"
                                   asp-route-tipo="@Context.Request.Query["tipo"]">
                                    Anterior
                                </a>
                            </li>

                            @for (int i = 1; i <= Model.TotalPaginas; i++)
                            {
                                <li class="page-item @(i == Model.PaginaActual ? "active" : "")">
                                    <a class="page-link" asp-action="Index"
                                       asp-route-pagina="@i"
                                       asp-route-estado="@Context.Request.Query["estado"]"
                                       asp-route-tipo="@Context.Request.Query["tipo"]">
                                        @i
                                    </a>
                                </li>
                            }

                            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                                <a class="page-link" asp-action="Index"
                                   asp-route-pagina="@(Model.PaginaActual + 1)"
                                   asp-route-estado="@Context.Request.Query["estado"]"
                                   asp-route-tipo="@Context.Request.Query["tipo"]">
                                    Siguiente
                                </a>
                            </li>
                        </ul>
                    </nav>
                }

                <div class="text-muted text-center mt-2">
                    Mostrando @Model.Cuentas.Count() de @Model.TotalRegistros registros
                </div>
            }
            else
            {
                <div class="alert alert-info">
                    No hay cuentas contables registradas.
                    @if (Context.Request.Query.Any())
                    {
                        <br />
                        <a asp-action="Index" class="alert-link">Mostrar todas las cuentas</a>
                    }
                </div>
            }
        </div>
    </div>
</div>

<!-- Modal de confirmación eliminación -->
<div class="modal fade" id="confirmModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
                <div class="alert alert-warning mt-2">
                    <i class="bi bi-exclamation-triangle"></i>
                    Solo se puede eliminar si no tiene datos relacionados (asientos).
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmDelete">Eliminar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal de confirmación cambio de estado -->
<div class="modal fade" id="confirmEstadoModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Cambiar Estado</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="estadoMessage"></p>
                <div class="alert alert-info mt-2">
                    <i class="bi bi-info-circle"></i>
                    Las cuentas inactivas no aparecerán en los listados para crear asientos.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="confirmEstadoChange">Confirmar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            let cuentaIdToDelete;
            let cuentaIdToToggle;
            let nuevoEstado;

            // Abrir modal de confirmación para eliminar
            $('.btn-eliminar').click(function () {
                cuentaIdToDelete = $(this).data('id');
                $('#confirmModal').modal('show');
            });

            // Abrir modal de confirmación para cambiar estado
            $('.btn-toggle-estado').click(function () {
                cuentaIdToToggle = $(this).data('id');
                let estadoActual = $(this).data('estado');
                nuevoEstado = !estadoActual;

                let accion = nuevoEstado ? "activar" : "desactivar";
                let textoEstado = nuevoEstado ? "Activa" : "Inactiva";

                $('#estadoMessage').text(`¿Desea ${accion} esta cuenta? El estado cambiará a "${textoEstado}".`);
                $('#confirmEstadoModal').modal('show');
            });

            // Confirmar eliminación
            $('#confirmDelete').click(function () {
                $.ajax({
                    url: '@Url.Action("Eliminar", "CuentasContables")',
                    type: 'POST',
                    data: { id: cuentaIdToDelete },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Error al procesar la solicitud.');
                    },
                    complete: function () {
                        $('#confirmModal').modal('hide');
                    }
                });
            });

            // Confirmar cambio de estado
            $('#confirmEstadoChange').click(function () {
                $.ajax({
                    url: '@Url.Action("ToggleEstado", "CuentasContables")',
                    type: 'POST',
                    data: {
                        id: cuentaIdToToggle,
                        nuevoEstado: nuevoEstado
                    },
                    headers: {
                        'RequestVerificationToken': $('input[name="__RequestVerificationToken"]').val()
                    },
                    success: function (response) {
                        if (response.success) {
                            location.reload();
                        } else {
                            alert(response.message);
                        }
                    },
                    error: function () {
                        alert('Error al cambiar el estado.');
                    },
                    complete: function () {
                        $('#confirmEstadoModal').modal('hide');
                    }
                });
            });

            // Auto-dismiss alerts after 5 seconds
            setTimeout(function () {
                $('.alert').alert('close');
            }, 5000);

            // Mantener filtros en selects
            let filtroEstado = '@Context.Request.Query["estado"]';
            let filtroTipo = '@Context.Request.Query["tipo"]';

            if (filtroEstado) {
                $('#filtroEstado').val(filtroEstado);
            }
            if (filtroTipo) {
                $('#filtroTipo').val(filtroTipo);
            }
        });
    </script>
}