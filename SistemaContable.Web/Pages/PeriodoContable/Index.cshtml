@page
@model SistemaContable.Web.Pages.PeriodoContable.IndexModel
@{
    ViewData["Title"] = "Periodos Contables";
}

<h2>Periodos Contables</h2>

<div class="d-flex justify-content-between mb-3 align-items-center">
    <a asp-page="Create" class="btn btn-primary">Nuevo Periodo</a>
    <form method="get" class="d-flex align-items-center">
        <label class="me-2">Estado:</label>
        <select name="filtro" class="form-select form-select-sm" onchange="this.form.submit()">
            <!option value="Todos" @(Model.Filtro == "Todos" ? "selected" : "")>Todos</!option>
            <!option value="Abierto" @(Model.Filtro == "Abierto" ? "selected" : "")>Abiertos</!option>
            <!option value="Cerrado" @(Model.Filtro == "Cerrado" ? "selected" : "")>Cerrados</!option>
        </select>
    </form>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Año</th>
            <th>Mes</th>
            <th>Estado</th>
            <th>Usuario Cierre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Periodos)
        {
            <tr>
                <td>@item.Anio</td>
                <td>@item.Mes</td>
                <td>
                    @if (item.Estado == 1)
                    {
                        <span class="badge bg-success">Abierto</span>
                    }
                    else if (item.Estado == 2)
                    {

                        <span class="badge bg-danger">Cerrado</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">@item.Estado</span>
                    }
                </td>
                <td>@(item.UsuarioCierre ?? "-")</td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.IdPeriodo"
                       asp-route-p="@Model.PaginaActual"
                       asp-route-filtro="@Model.Filtro"
                       class="btn btn-warning btn-sm">Editar</a>
                    <a asp-page="Delete" asp-route-id="@item.IdPeriodo" class="btn btn-danger btn-sm">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-route-p="@(Model.PaginaActual - 1)"
                   asp-route-filtro="@Model.Filtro">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                    <a class="page-link"
                       asp-route-p="@i"
                       asp-route-filtro="@Model.Filtro">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-route-p="@(Model.PaginaActual + 1)"
                   asp-route-filtro="@Model.Filtro">Siguiente</a>
            </li>

        </ul>
    </nav>
}