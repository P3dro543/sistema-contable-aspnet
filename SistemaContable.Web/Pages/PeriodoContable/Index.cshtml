@page
@model SistemaContable.Web.Pages.PeriodoContable.IndexModel
@{
    ViewData["Title"] = "Periodos Contables";
}

<h2>Periodos Contables</h2>

<div class="d-flex justify-content-between mb-3 align-items-center">
    <a asp-page="Create" class="btn btn-primary">Nuevo Periodo</a>
    <form method="get" class="d-flex align-items-center">
        <label class="me-2">Estado:</label>
        <select name="filtro" class="form-select form-select-sm" onchange="this.form.submit()">
            <!option value="Todos" @(Model.Filtro == "Todos" ? "selected" : "")>Todos</!option>
            <!option value="Abierto" @(Model.Filtro == "Abierto" ? "selected" : "")>Abiertos</!option>
            <!option value="Cerrado" @(Model.Filtro == "Cerrado" ? "selected" : "")>Cerrados</!option>
        </select>
    </form>
</div>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Año</th>
            <th>Mes</th>
            <th>Estado</th>
            <th>Usuario Cierre</th>
            <th>Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Periodos)
        {
            <tr>
                <td>@item.Anio</td>
                <td>@item.Mes</td>
                <td>
                    @if (item.Estado == 1)
                    {
                        <span class="badge bg-success">Abierto</span>
                    }
                    else if (item.Estado == 2)
                    {

                        <span class="badge bg-danger">Cerrado</span>
                    }
                    else
                    {

                        <span class="badge bg-secondary">@item.Estado</span>
                    }
                </td>
                <td>@(item.UsuarioCierre ?? "-")</td>
                <td>
                    <a asp-page="./Edit"
                       asp-route-id="@item.IdPeriodo"
                       asp-route-p="@Model.PaginaActual"
                       asp-route-filtro="@Model.Filtro"
                       class="btn btn-warning btn-sm">Editar</a>
                    <button type="button" class="btn btn-danger btn-sm" data-bs-toggle="modal" data-bs-target="#deleteModal" data-id="@item.IdPeriodo">Eliminar</button>
                </td>
            </tr>
        }
    </tbody>
</table>

<!-- Modal de Eliminación -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">Confirmar Eliminación</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                ¿Realmente desea eliminar el elemento seleccionado?
            </div>
            <div class="modal-footer">
                <form method="post" asp-page-handler="Eliminar">
                    <input type="hidden" name="id" id="deleteId" value="" />
                    <button type="submit" class="btn btn-danger">Sí</button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">No</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            var deleteModal = document.getElementById('deleteModal');
            deleteModal.addEventListener('show.bs.modal', function (event) {
                var button = event.relatedTarget;
                var id = button.getAttribute('data-id');
                var modalInput = deleteModal.querySelector('#deleteId');
                modalInput.value = id;
            });
        });
    </script>
}

@if (Model.TotalPaginas > 1)
{
    <nav aria-label="Navegación de páginas" class="mt-4">
        <ul class="pagination justify-content-center">

            <li class="page-item @(Model.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link"
                   asp-route-p="@(Model.PaginaActual - 1)"
                   asp-route-filtro="@Model.Filtro">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.TotalPaginas; i++)
            {
                <li class="page-item @(Model.PaginaActual == i ? "active" : "")">
                    <a class="page-link"
                       asp-route-p="@i"
                       asp-route-filtro="@Model.Filtro">@i</a>
                </li>
            }

            <li class="page-item @(Model.PaginaActual == Model.TotalPaginas ? "disabled" : "")">
                <a class="page-link"
                   asp-route-p="@(Model.PaginaActual + 1)"
                   asp-route-filtro="@Model.Filtro">Siguiente</a>
            </li>

        </ul>
    </nav>
}