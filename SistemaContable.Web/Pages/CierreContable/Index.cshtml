@page
@model SistemaContable.Web.Pages.CierreContable.IndexModel
@{
    ViewData["Title"] = "Cierre Contable";
}

<h2>Cierre Contable Mensual</h2>

<div class="card mb-4 shadow-sm">
    <div class="card-body">
        <form method="post" asp-page-handler="Previsualizar">
            <div class="row align-items-end">
                <div class="col-md-6">
                    <label class="form-label">Periodo a Cerrar:</label>
                    <select name="IdPeriodoSeleccionado" class="form-select" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var p in Model.PeriodosAbiertos)
                        {
                            <option value="@p.IdPeriodo" selected="@(p.IdPeriodo == Model.IdPeriodoSeleccionado)">
                                @p.Mes / @p.Anio
                            </option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-calculator"></i> Simular Cierre
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

@if (!string.IsNullOrEmpty(Model.Mensaje))
{
    <div class="alert @(Model.Exito ? "alert-success" : "alert-danger")">@Model.Mensaje</div>
}

@if (Model.Resultado != null)
{
    <div class="card shadow">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Balance de Comprobación</h5>
            @if (Model.Resultado.EsBalanceado)
            {
                <span class="badge bg-success">BALANCEADO</span>
            }
            else
            {
                <span class="badge bg-danger">DESBALANCEADO</span>
            }
        </div>
        <div class="card-body">
            <table class="table table-bordered table-striped">
                <thead class="table-light">
                    <tr>
                        <th>Código</th>
                        <th>Cuenta</th>
                        <th class="text-end">Mov. Debe</th>
                        <th class="text-end">Mov. Haber</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.Resultado.Cuentas)
                    {
                        <tr>
                            <td>@c.Codigo</td>
                            <td>@c.Cuenta</td>
                            <td class="text-end">@c.MovimientoDebe.ToString("N2")</td>
                            <td class="text-end">@c.MovimientoHaber.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
                <tfoot class="fw-bold table-secondary">
                    <tr>
                        <td colspan="2" class="text-end">TOTALES:</td>
                        <td class="text-end text-primary">@Model.Resultado.TotalDebe.ToString("N2")</td>
                        <td class="text-end text-primary">@Model.Resultado.TotalHaber.ToString("N2")</td>
                    </tr>
                </tfoot>
            </table>

            @if (Model.Resultado.EsBalanceado)
            {
                <form method="post" asp-page-handler="Confirmar" class="mt-3">
                    <input type="hidden" name="IdPeriodoConfirmado" value="@Model.IdPeriodoSeleccionado" />
                    <div class="alert alert-info">
                        <strong>¡Todo correcto!</strong> Los saldos cuadran. Proceda a cerrar el periodo.
                    </div>
                    <button type="submit" class="btn btn-success btn-lg w-100">CONFIRMAR CIERRE</button>
                </form>
            }
            else
            {
                <div class="alert alert-danger mt-3">
                    <strong>Error:</strong> Los movimientos no cuadran. Revise los asientos antes de cerrar.
                </div>
            }
        </div>
    </div>
}

@if (Model.Resultado != null && Model.Resultado.TotalPaginas > 1)
{
    <nav aria-label="Paginación de cierre">
        <ul class="pagination justify-content-center">
            <li class="page-item @(Model.Resultado.PaginaActual == 1 ? "disabled" : "")">
                <a class="page-link" asp-route-IdPeriodo="@Model.IdPeriodoSeleccionado" asp-route-p="@(Model.Resultado.PaginaActual - 1)">Anterior</a>
            </li>

            @for (int i = 1; i <= Model.Resultado.TotalPaginas; i++)
            {
                <li class="page-item @(Model.Resultado.PaginaActual == i ? "active" : "")">
                    <a class="page-link" asp-route-IdPeriodo="@Model.IdPeriodoSeleccionado" asp-route-p="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.Resultado.PaginaActual == Model.Resultado.TotalPaginas ? "disabled" : "")">
                <a class="page-link" asp-route-IdPeriodo="@Model.IdPeriodoSeleccionado" asp-route-p="@(Model.Resultado.PaginaActual + 1)">Siguiente</a>
            </li>
        </ul>
    </nav>
}